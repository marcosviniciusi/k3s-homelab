apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: syslog-gateway
  namespace: argocd
spec:
  destination:
    namespace: logging
    server: https://kubernetes.default.svc
  project: vinicima-prod
  source:
    path: kustomize/logging-stack/syslog-gayeway
    repoURL: git@github.com:vinicimatecnologia/k3s-homelab.git
    targetRevision: main
  syncPolicy:
    automated: {}

